<?xml version="1.0" encoding="UTF-8"?>
<!--  IIS site that publishes MEA Process Hub over HTTPS (reverse proxy to http://127.0.0.1:8765).
      Needs the IIS modules "URL Rewrite" and "Application Request Routing" (ARR) with
      ARR > Server Proxy Settings > Enable proxy = on, and HTTP_X_FORWARDED_PROTO added under
      URL Rewrite > View Server Variables (otherwise IIS answers 500.50).
      Bind the site to HTTPS (443) with the company certificate only; do not add an HTTP binding
      other than for a redirect.  This file was written for this purpose and has NOT been run on IIS here. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="MEA Process Hub" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8765/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- document imports and backups: up to 100 MB -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
