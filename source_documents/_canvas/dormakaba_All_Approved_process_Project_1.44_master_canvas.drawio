        <mxCell id="J369tWIYMDPUVP41Ma1_-31" value="Project Management Complete E2E Flow" style="text;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=top;rounded=0;fontStyle=0;fontSize=20;fontFamily=Helvetica;spacingTop=0;spacing=1;whiteSpace=wrap;labelBorderColor=none;labelBackgroundColor=none;horizontal=1;labelPosition=center;verticalLabelPosition=middle;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
