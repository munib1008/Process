        <mxCell id="8NcwU-GYVxepkZUVuLv_-33" value="&lt;p style=&quot;line-height: 100%;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Vetting LPO as per below criteria:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Delivery Terms&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Delivery Period&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Payment Terms&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" style="shape=dataStorage;fixedSize=1;align=left;strokeColor=default;size=0;spacing=2;fontSize=10;fontFamily=Helvetica;fillColor=#FFFFEe;spacingTop=0;spacingLeft=0;spacingBottom=0;spacingRight=0;strokeWidth=0.2;dashed=1;shadow=0;verticalAlign=middle;whiteSpace=wrap;labelBorderColor=none;labelBackgroundColor=none;fontStyle=0;horizontal=1;labelPosition=center;verticalLabelPosition=middle;rounded=0;html=1;fontColor=#000000;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" parent="1" vertex="1">
