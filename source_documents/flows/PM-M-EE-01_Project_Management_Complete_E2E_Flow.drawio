        <mxCell id="J369tWIYMDPUVP41Ma1_-28" value="Order Acceptance released" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E90FF;strokeWidth=2;fontColor=#484848;fontFamily=Arial;fontSize=10;align=center;spacingLeft=0;spacing=1;meaKind=activity;meaRole=Sales;" parent="1" vertex="1">
